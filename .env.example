# Forex Signal System - Environment Variables
# Copy to .env and fill in your values

# Twelve Data API (Primary data source)
# Get from: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# NVIDIA NIM API (Neural analysis with Llama 3.1 70B)
# Get from: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Telegram Bot
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# NewsAPI (High-impact news filter)
# Get from: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Database
DB_PATH=forex_signals.db

# Logging
LOG_LEVEL=INFO